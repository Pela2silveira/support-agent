GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# Viewer: solo carpeta/dashboard PACS (provisionado por grafana/ensure-viewer.sh)
GRAFANA_VIEWER_USER=viewer
GRAFANA_VIEWER_PASSWORD=change-me-viewer

# PACS host probes (blackbox ICMP + DICOM TCP) — generated into prometheus/file_sd/
SSS_PACS_HOST=
SSS_PACS_DICOM_PORT=11112

# SSS dcm4chee / Keycloak
SSS_DCM4CHEE_MULTI_PACS=true
SSS_DCM4CHEE_AUTH_HOST=
SSS_DCM4CHEE_AUTH_REALM=dcm4che
SSS_AUTH_CLIENT=
SSS_AUTH_TOKEN=
SSS_DCM4CHEE_HOST=

# Optional
# SSS_DCM4CHEE_AET=          # required when MULTI_PACS=false
SSS_DCM4CHEE_AET_PREFIX=PACS
SSS_DCM4CHEE_MWL_INTERVAL_SECONDS=1200
SSS_DCM4CHEE_TLS_VERIFY=true
SSS_DCM4CHEE_TZ=America/Argentina/Buenos_Aires

# Studies (AS_RECEIVED + ReceivingApplicationEntityTitleOfSeries per PACS AET)
SSS_STUDIES_RS_AET=AS_RECEIVED
SSS_STUDY_INSTANCE_UID_PREFIX=

# HTTP / token (optional)
# SSS_HTTP_CONNECT_TIMEOUT=15
# SSS_HTTP_READ_TIMEOUT=60
# SSS_TOKEN_REFRESH_SECONDS=240
# SSS_MAX_CONSECUTIVE_TRANSPORT_ERRORS=3

# SSS FortiGate SD-WAN (API token; used by configure.sh → fortigate-key.yaml)
SSS_FORTIGATE_URL=
SSS_FORTIGATE_TOKEN=
# SSS_FORTIGATE_INSECURE=true
